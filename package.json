{
  "name": "aura-twin",
  "version": "4.0.0",
  "private": true,
  "description": "Research digital twin with documented wearable observations and synthetic EHR context",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build_site.mjs",
    "start": "node --env-file-if-exists=.env.auth.local server.mjs",
    "dev": "node --env-file-if-exists=.env.auth.local --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:data": "python -m unittest discover -s ml -p test_*.py -v",
    "train": "python ml/train_v3.py --phase develop --output-dir work/reproduced-v3 --work-dir work/reproduced-v3-cache",
    "train:freeze": "python ml/train_v3.py --phase freeze --output-dir work/reproduced-v3 --work-dir work/reproduced-v3-cache",
    "train:evaluate": "python ml/train_v3.py --phase evaluate --output-dir work/reproduced-v3 --work-dir work/reproduced-v3-cache",
    "train:legacy": "python ml/train.py",
    "stress": "python ml/stress_test.py",
    "research:develop": "python ml/train_research.py --phase develop --output-dir work/reproduced-research --work-dir work/reproduced-research-cache",
    "research:freeze": "python ml/train_research.py --phase seal --output-dir work/reproduced-research --work-dir work/reproduced-research-cache",
    "research:evaluate": "python ml/train_research.py --phase evaluate --output-dir work/reproduced-research --work-dir work/reproduced-research-cache",
    "research:audit": "node scripts/audit_research_runtime.mjs",
    "build:frontend": "vite build --config frontend/vite.config.js",
    "dev:frontend": "vite --config frontend/vite.config.js"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  }
}
