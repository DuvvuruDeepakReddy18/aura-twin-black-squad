{
  "name": "aura-twin",
  "version": "3.0.0",
  "private": true,
  "description": "Black Squad's synthetic patient digital twin with two-hour glucose forecasting",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:data": "python -m unittest discover -s ml -p test_*.py -v",
    "train": "python ml/train_v3.py --phase develop --output-dir work/reproduced-v3 --work-dir work/reproduced-v3-cache",
    "train:freeze": "python ml/train_v3.py --phase freeze --output-dir work/reproduced-v3 --work-dir work/reproduced-v3-cache",
    "train:evaluate": "python ml/train_v3.py --phase evaluate --output-dir work/reproduced-v3 --work-dir work/reproduced-v3-cache",
    "train:legacy": "python ml/train.py",
    "stress": "python ml/stress_test.py"
  }
}
